---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Prompt from '../../components/Prompt.astro';
import Tag from '../../components/Tag.astro';

export async function getStaticPaths() {
    const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
    return projects.map((project, i) => ({
        params: { slug: project.id },
        props: {
            project,
            prev: projects[(i - 1 + projects.length) % projects.length],
            next: projects[(i + 1) % projects.length],
        },
    }));
}

const { project, prev, next } = Astro.props;
const { Content } = await render(project);
const { data } = project;
const path = `~/projects/${project.id}`;
---

<Base title={data.title} description={`${data.title} — ${data.tagline}`}>
    <Prompt path={path} command={`cat ${data.file}`} />

    <article class="project">
        <header class="project-head">
            <h1 class="project-title">{data.title}</h1>
            <p class="subtitle">{data.tagline}</p>
            <div class="project-stack">
                <span class="muted">stack:</span>
                {data.stack.map(s => <Tag label={s} />)}
            </div>
            {data.repo && <a class="project-repo" href={data.repo} target="_blank" rel="noopener">&gt;&gt; source</a>}
        </header>

        <div class="project-body">
            <Content />
        </div>

        <footer class="project-skills">
            <span class="muted">skills shown:</span>
            {data.skills.map(s => <Tag label={s} />)}
        </footer>
    </article>

    <nav class="project-nav" aria-label="Other projects">
        <a href={`/projects/${prev.id}`}>cd ../{prev.id}</a>
        <a href="/projects">cd ..</a>
        <a href={`/projects/${next.id}`}>cd ../{next.id}</a>
    </nav>
</Base>

<style>
    .project { margin-top: 18px; }

    .project-title {
        font-family: var(--font-header);
        margin-bottom: 6px;
    }
    .project-head .subtitle { margin-bottom: 16px; }

    .project-stack, .project-skills {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px 8px;
        font-size: 0.85rem;
    }
    .project-repo { display: inline-block; margin-top: 12px; }

    .project-body { margin-top: 28px; }
    .project-body :global(h2) {
        font-size: 1rem;
        color: var(--st-color);
        margin: 28px 0 8px;
    }
    .project-body :global(h2)::before {
        content: '## ';
        color: var(--sub-header-color);
    }
    .project-body :global(p) { margin: 6px 0; }
    .project-body :global(ul li::before) { content: '→'; color: var(--sub-header-color); }


    .project-body :global(.proj-hero) { margin: 0 0 8px; }
    .project-body :global(.proj-hero img) { border-radius: 24px; }
    .project-body :global(.shot) { margin: 18px 0; text-align: center; }
    .project-body :global(.shot img) {
        max-width: 100%;
        height: auto;
        border-radius: 10px;
        border: 1px solid var(--border-soft);
    }
    .project-body :global(.shot-wide img) { width: 100%; }
    .project-body :global(.shot figcaption) {
        margin-top: 6px;
        font-size: 0.8rem;
        color: var(--sub-header-color);
    }
    .project-body :global(.shots) {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin: 18px 0;
    }
    .project-body :global(.shots-2) { grid-template-columns: repeat(2, 1fr); }
    .project-body :global(.shots .shot) { margin: 0; }
    @media (max-width: 640px) {
        .project-body :global(.shots) { grid-template-columns: repeat(2, 1fr); }
    }
    .project-body :global(table) {
        width: 100%;
        border-collapse: collapse;
        margin: 12px 0;
        font-size: 0.85rem;
    }
    .project-body :global(th), .project-body :global(td) {
        text-align: left;
        vertical-align: top;
        padding: 6px 10px;
        border-bottom: 1px solid var(--border-soft);
    }
    .project-body :global(th) { color: var(--st-color); }
    .project-body :global(pre) {
        background: var(--bg-deep);
        border: 1px solid var(--border-soft);
        border-radius: 8px;
        padding: 12px 14px;
        overflow-x: auto;
        font-size: 0.82rem;
        margin: 12px 0;
    }
    .project-body :global(blockquote) {
        margin: 12px 0;
        padding: 4px 14px;
        border-left: 3px solid var(--header-color);
        color: var(--sub-header-color);
    }
    .project-body :global(.proj-links) {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 14px;
        margin: 14px 0;
    }
    .project-body :global(.proj-link-site) {
        display: inline-block;
        padding: 12px 16px;
        border: 1px solid var(--link-color);
        border-radius: 10px;
    }

    .project-skills {
        margin-top: 32px;
        padding-top: 16px;
        border-top: 1px solid var(--border-soft);
    }

    .project-nav {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 40px;
    }
</style>
